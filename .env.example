# Task 15: consent-gated PostHog analytics.
# PostHog project API key (marketing project). Public by design (posthog-js
# runs client-side) -- NEXT_PUBLIC_* so Next.js inlines it into the browser
# bundle. Left blank on purpose: the real project key isn't available yet
# (code-complete, key wired later). Everything analytics-related no-ops
# gracefully while this is unset -- see src/components/PostHogProvider.tsx.
NEXT_PUBLIC_POSTHOG_KEY=

# Later tasks -- placeholders only, not wired up yet.

# Supabase (waitlist submissions, future auth)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional/waitlist email)
RESEND_API_KEY=

# Sanity (CMS-backed content, if/when adopted)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_TOKEN=

# Site URL (canonical origin for metadata, absolute links, etc.)
NEXT_PUBLIC_SITE_URL=https://kinectnow.com
