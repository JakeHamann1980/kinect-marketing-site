# Task 15: consent-gated PostHog analytics.
# PostHog project API key (marketing project). Public by design (posthog-js
# runs client-side) -- NEXT_PUBLIC_* so Next.js inlines it into the browser
# bundle. Left blank on purpose: the real project key isn't available yet
# (code-complete, key wired later). Everything analytics-related no-ops
# gracefully while this is unset -- see src/components/PostHogProvider.tsx.
NEXT_PUBLIC_POSTHOG_KEY=

# Later tasks -- placeholders only, not wired up yet.

# Supabase (waitlist submissions, future auth)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional/waitlist email)
RESEND_API_KEY=

# Sanity (CMS-backed content -- Task 17: Sanity Schemas + Studio; Task 18:
# Seed Script + Page Wiring + Revalidation).
# Project "KINECT Marketing" (org "KINECT"), created 2026-07-25.
# Not secret (NEXT_PUBLIC_* is inlined client-side) -- the real project ID is
# "gxxphuan", dataset "production". Left blank here on purpose; set the real
# values in your own .env.local (gitignored).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=

# Task 18 design decision: the "production" dataset's visibility was flipped
# from private (Task 17's default) to PUBLIC (`npx sanity datasets
# visibility set production public -p gxxphuan`). The content behind it is
# public marketing copy, so public read means every page fetch in
# src/lib/sanity.ts is a plain, unauthenticated, CDN-cacheable GROQ query --
# no read token is needed in ANY environment (dev, preview, prod), so there
# is deliberately no SANITY_API_READ_TOKEN var here. Writes (the seed
# script, `npm run seed:sanity`) authenticate via the Sanity CLI's own
# logged-in user session (`sanity exec --with-user-token`), not a token
# stored in env, so there's nothing to configure for seeding either.

# Verifies that POST /api/revalidate requests genuinely came from Sanity's
# webhook (HMAC signature over `sanity-webhook-signature`, via
# next-sanity/webhook's `parseBody`) before calling revalidateTag("content").
# Generate a real value with `openssl rand -hex 32` (or similar) and set the
# identical value on the Sanity webhook's own "Secret" field -- see
# docs/LAUNCH.md item 3 for the exact webhook configuration steps.
SANITY_REVALIDATE_SECRET=

# Site URL (canonical origin for metadata, absolute links, etc.)
NEXT_PUBLIC_SITE_URL=https://kinectnow.com

# Draft pages (user-directed 2026-08-03). Set to "1" locally to expose
# routes that are built but NOT approved for the live site -- today /docs
# and /platform, plus the nav "Docs" item and the footer "Platform" column.
# Leave UNSET in Vercel: with it unset those routes 404 and their links are
# filtered out. See src/lib/draft-pages.ts.
NEXT_PUBLIC_ENABLE_DRAFT_PAGES=
